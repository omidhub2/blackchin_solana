{
  "name": "blackchin-solana-wallet-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solana wallet engine with encrypted PostgreSQL storage",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "wallet:create": "node create-wallet.js",
    "test": "node --test",
    "test:wallet": "node --test test/wallet-storage.test.js",
    "sol:receive": "node receive-sol.js",
    "sol:send": "node send-sol.js",
    "test:solana": "node --test test/sol-transfer.test.js",
    "test:hd": "node --test test/hd-derivation.test.js test/hd-security.test.js test/hd-wallet-service.test.js test/hd-signer-and-child.test.js test/hd-transactions.test.js test/hd-hardening.test.js",
    "test:api": "node --test test/api.test.js",
    "test:ledger": "node --test test/ledger-immutability.test.js",
    "test:unit": "node --test test/hd-derivation.test.js test/hd-security.test.js test/hd-wallet-service.test.js test/hd-signer-and-child.test.js test/hd-transactions.test.js test/hd-hardening.test.js test/ledger-immutability.test.js test/sol-transfer.test.js test/migrations.test.js test/api.test.js test/withdrawal-reconciliation.service.test.js",
    "check:imports": "node test/tools/check-imports.mjs",
    "api:start": "node src/index.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:status": "node scripts/migrate.js status",
    "dashboard:user": "node scripts/create-dashboard-user.js",
    "test:migrations": "node --test test/migrations.test.js",
    "test:withdrawal-reconciliation": "node --test test/withdrawal-reconciliation.service.test.js",
    "test:dashboard": "node --test test/dashboard-auth.test.js test/hot-wallet.service.test.js test/operational-event.repository.test.js",
    "load:test": "node scripts/http-load.mjs",
    "test:security:providers": "node --test test/envelope-crypto.test.js test/vault-transit-key-provider.test.js",
    "vault:local:up": "docker compose -f infra/local/vault/docker-compose.yml up -d",
    "vault:local:down": "docker compose -f infra/local/vault/docker-compose.yml down",
    "vault:local:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/local/vault/bootstrap.ps1"
  },
  "dependencies": {
    "@scure/bip39": "^2.4.0",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^18.0.10",
    "fastify": "^5.6.2",
    "pg": "^8.23.1"
  },
  "overrides": {
    "jayson": "5.0.0"
  }
}
