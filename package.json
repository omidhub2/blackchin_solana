{
  "name": "blackchin-solana-wallet-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solana wallet engine with encrypted PostgreSQL storage",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "wallet:create": "node create-wallet.js",
    "test": "node --test",
    "test:wallet": "node --test test/wallet-storage.test.js",
    "sol:receive": "node receive-sol.js",
    "sol:send": "node send-sol.js",
    "test:solana": "node --test test/sol-transfer.test.js",
    "api:start": "node src/index.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:status": "node scripts/migrate.js status",
    "test:migrations": "node --test test/migrations.test.js"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "fastify": "^5.6.2"
  }
}
