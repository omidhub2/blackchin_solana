# PostgreSQL. For hosted PostgreSQL use sslmode=verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# 32-byte AES-256 key encoded as 64 hexadecimal characters.
# This key protects legacy standalone wallets AND every HD root mnemonic.
# Losing it makes all stored keys unrecoverable.
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Optional key rotation: ENCRYPTION_KEY_V<n> supersedes ENCRYPTION_KEY for new
# writes. Records keep their key_version, so old rows stay decryptable while the
# old variable is still configured. Never remove a version that rows reference.
# ENCRYPTION_KEY_V2=REPLACE_WITH_64_HEX_CHARACTERS

# Dedicated tenant runtime connection. The login must be a non-superuser,
# non-BYPASSRLS role and a member of blackchin_tenant_runtime.
# It must NOT be the migration/table-owner connection used by DATABASE_URL.
# Tenant endpoints fail closed (503) if this pool or its HMAC key is absent.
TENANT_DATABASE_URL=postgresql://TENANT_LOGIN:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# 32-byte HMAC key used to sign request-scoped tenant identity.
# The database stores the matching key in private.tenant_context_secrets.
# Generate with: openssl rand -hex 32
# Rotation requires a coordinated database secret update and API restart.
TENANT_CONTEXT_HMAC_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Solana network configuration. Defaults to devnet when unset.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Confirm with getGenesisHash on the configured RPC; mismatch blocks startup.
SOLANA_EXPECTED_GENESIS_HASH=GH7ome3EiwEr7tu9JuTh2dpYWBJK3z69Xm1ZE3MEE6JC
SOLANA_COMMITMENT=confirmed
# Optional dedicated WebSocket endpoint (wss://). When omitted, web3.js derives
# the WebSocket URL from SOLANA_RPC_URL.
# SOLANA_WS_URL=wss://api.devnet.solana.com/

# REST API. Generate a random secret of at least 32 characters.
# This is a single trusted-backend credential, NOT end-user authentication.
API_ACCESS_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
API_HOST=127.0.0.1
API_PORT=3000

# Deposit scanner and deposit reconciliation use a separate, restricted pool.
# Required when either worker is enabled. Provision a non-superuser login with
# BYPASSRLS and membership in blackchin_deposit_worker_runtime after migration
# 0016; this login cannot read encrypted HD mnemonic columns.
# DEPOSIT_WORKER_DATABASE_URL=postgresql://DEPOSIT_WORKER_LOGIN:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
#
# Native SOL deposit scanner.
# DEPOSIT_SCANNER_ENABLED=false
# DEPOSIT_SCANNER_SCOPE=all
# DEPOSIT_SCANNER_INTERVAL_MS=15000
#
# Periodic verification of previously recorded SOL deposits.
# Enable only after migration 0007 has been applied.
DEPOSIT_RECONCILIATION_ENABLED=false
DEPOSIT_RECONCILIATION_INTERVAL_MS=60000

# Periodic verification/recovery of ambiguous native SOL withdrawals.
# Enable only after migration 0008 has been applied.
WITHDRAWAL_RECONCILIATION_ENABLED=false
WITHDRAWAL_RECONCILIATION_INTERVAL_MS=60000

# Durable webhook delivery worker. Tenant endpoints configured through the
# dashboard are resolved per event. WEBHOOK_ENDPOINT/WEBHOOK_SECRET are an
# optional legacy platform fallback and must be a public HTTPS URL / 32+ chars.
WEBHOOK_DELIVERY_ENABLED=false
WEBHOOK_DELIVERY_INTERVAL_MS=5000
# WEBHOOK_ENDPOINT=https://partner.example.com/blackchin/webhooks
# WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Dashboard operator sessions. Set true in production behind TLS.
# Create the first operator with: npm run dashboard:user -- --email=... --password=...
DASHBOARD_COOKIE_SECURE=false


# Native SOL sweeper. Disabled by default; keep both execution switches false
# until policies, reserve/fee limits, signer role and Devnet recovery tests pass.
# Requires migration 0018 and a dedicated least-privilege DB role.
SWEEPER_ENABLED=false
SWEEPER_EXECUTION_ENABLED=false
SWEEPER_MAINNET_EXECUTION_ENABLED=false
SWEEPER_INTERVAL_MS=60000
# SWEEPER_DATABASE_URL=postgresql://SWEEPER_LOGIN:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
