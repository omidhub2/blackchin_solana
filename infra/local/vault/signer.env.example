# Copy to signer process environment only. Never commit the populated file.
# Local development Vault is bound to 127.0.0.1 and uses disposable dev-mode storage.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TRANSIT_KEY_NAME=blackchin-envelope
# Obtain a short-lived token from: npm run vault:local:bootstrap
# VAULT_SIGNER_TOKEN=DO_NOT_COMMIT
